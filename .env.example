# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Vector Store Configuration (Qdrant)
# Use ':memory:' for fast local in-memory storage, or a remote URL (e.g., http://localhost:6333)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=financial_reports

# Critic Evaluation Thresholds (1-5 scale)
EVAL_MIN_FAITHFULNESS=4
EVAL_MIN_RELEVANCY=4
